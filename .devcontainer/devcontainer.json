// Dev container for The Dozens API (Django 6 + DRF + Graphene, Python 3.14, uv).
// Spec: https://containers.dev/implementors/json_reference/
//
// Services (docker-compose.yml): the dev container plus Postgres 15 and Redis 7,
// matching CI's `test` job. All three share one network, so both are on localhost.
//
// Secrets come from Doppler (project "yo-momma", config "dev"), as on the host.
// Export DOPPLER_TOKEN on the host before opening the container, or run
// `doppler login` inside it. With a token, direnv's .envrc and
// scripts/with_doppler.sh load the Doppler dev config, which points at the
// remote dev database. To run the tests against the local services instead, the
// way CI does:
//   doppler run --preserve-env -- task test:coverage
{
	"name": "The Dozens API (Django)",

	"dockerComposeFile": "docker-compose.yml",
	"service": "app",
	"runServices": ["app", "db", "redis"],
	"workspaceFolder": "/workspaces/the-dozens-django",
	"shutdownAction": "stopCompose",

	"features": {
		// Package manager; also installs the Python interpreter (see updateContentCommand)
		"ghcr.io/va-h/devcontainers-features/uv:1": {},
		// Command-line clients for the local database and cache
		"ghcr.io/devcontainers-extra/features/apt-get-packages:1": {
			"packages": "libmagic1,postgresql-client,redis-tools"
		},
		// Secrets injection (.envrc, scripts/with_doppler.sh, production CMD)
		"ghcr.io/itsmechlark/features/doppler:2": {},
		// Taskfile.yml runner
		"ghcr.io/devcontainers-extra/features/go-task:1": {},
		// Loads .envrc (Django configuration + Doppler secrets)
		"ghcr.io/devcontainers-extra/features/direnv:1": {},
		// `task build-image` / `task compose:up` use the host's Docker daemon
		"ghcr.io/devcontainers/features/docker-outside-of-docker:1": {},
		// PRs, releases, repo API
		"ghcr.io/devcontainers/features/github-cli:1": {},
		// Run .github/workflows locally
		"ghcr.io/dhoeric/features/act:1": {}
	},

	"containerEnv": {
		// Non-secret settings, mirroring .envrc and the Taskfile
		"DJANGO_CONFIGURATION": "Development",
		"DJANGO_SETTINGS_MODULE": "core.settings",
		"PYTHONPATH": "/workspaces/the-dozens-django",
		"PYTHONUNBUFFERED": "1",
		"API_VERSION": "1.0.1",
		"DOPPLER_PROJECT": "yo-momma",
		"DOPPLER_CONFIG": "dev",
		"DOPPLER_ENVIRONMENT": "dev",

		// Local services, same values as CI's test job. Doppler overrides these
		// unless it is run with --preserve-env.
		"PG_DATABASE_HOST": "localhost",
		"PG_DATABASE_PORT": "5432",
		"PG_DATABASE_USER": "root",
		"PG_DATABASE_PASSWORD": "postgres",
		"POSTGRES_DB": "test_db",
		"USE_REDIS_CACHE": "true",
		"REDIS_CACHE_TOKEN": "redis://localhost:6379/0",

		// Python 3.14 is required by pyproject.toml; this also overrides any
		// older .python-version left in the working copy.
		"UV_PYTHON": "3.14",
		// The uv cache and .venv are separate volumes, so hardlinks can't cross them
		"UV_LINK_MODE": "copy"
	},

	// Secrets are passed through from the host environment and never written to the image
	"remoteEnv": {
		"DOPPLER_TOKEN": "${localEnv:DOPPLER_TOKEN}",
		"CODACY_PROJECT_TOKEN": "${localEnv:CODACY_PROJECT_TOKEN}",
		"PATH": "/workspaces/the-dozens-django/.venv/bin:${containerEnv:PATH}"
	},

	// Install dependencies here rather than in postCreate so Codespaces prebuilds can cache the step.
	// Same install as `task install` and CI: the test and dev groups, exactly as pinned in uv.lock.
	"updateContentCommand": "sudo chown -R vscode:vscode .venv /home/vscode/.cache/uv && uv python install 3.14 && uv sync --locked --group test --group dev",

	"postCreateCommand": {
		// Load .envrc automatically in interactive shells
		"direnv-hook": "grep -q 'direnv hook bash' ~/.bashrc || echo 'eval \"$(direnv hook bash)\"' >> ~/.bashrc; grep -q 'direnv hook zsh' ~/.zshrc 2>/dev/null || echo 'eval \"$(direnv hook zsh)\"' >> ~/.zshrc; if [ -f .envrc ]; then direnv allow .; fi",
		// The config lives in .configs/ (see `task install`). Only installed when no hook
		// exists yet, because .git is shared with the host and the hook records this
		// container's Python path.
		"pre-commit": "test -f .git/hooks/pre-commit || .venv/bin/pre-commit install -c .configs/.pre-commit-config.yaml"
	},

	"postStartCommand": "git config --global --add safe.directory /workspaces/the-dozens-django",

	"forwardPorts": [8000, 9555, 5432, 6379],
	"portsAttributes": {
		"8000": {
			"label": "Django dev server (task run:dev / runserver)",
			"onAutoForward": "notify"
		},
		"9555": {
			"label": "Gunicorn (production config, .deploy/gunicorn.conf.py)",
			"onAutoForward": "silent"
		},
		"5432": {
			"label": "Postgres (local)",
			"onAutoForward": "silent"
		},
		"6379": {
			"label": "Redis (local)",
			"onAutoForward": "silent"
		}
	},

	"hostRequirements": {
		"cpus": 2,
		"memory": "4gb"
	},

	"customizations": {
		"vscode": {
			"extensions": [
				// Python core
				"ms-python.python",
				"ms-python.vscode-pylance",
				"ms-python.debugpy",
				// Formatters / linters used by `task lint:lint` and pre-commit
				"ms-python.black-formatter",
				"ms-python.isort",
				"charliermarsh.ruff",
				"ms-python.pylint",
				"ms-python.mypy-type-checker",
				"monosans.djlint",
				"sourcery.sourcery",
				"codacy-app.codacy",
				// Django
				"junstyle.vscode-django-support",
				"bibhasdn.django-html",
				"DhavalVira.django-import-libraries",
				"jitdev.copy-django-model-fields",
				"yardensachs.copy-python-path",
				// GraphQL (Graphene schema)
				"GraphQL.vscode-graphql",
				"GraphQL.vscode-graphql-syntax",
				// Environment / tooling
				"doppler.doppler-vscode",
				"mkhl.direnv",
				"task.vscode-task",
				"redhat.vscode-yaml",
				"tamasfe.even-better-toml",
				"ms-azuretools.vscode-docker",
				"ms-ossdata.vscode-pgsql",
				// Coverage (cobertura.xml from `task test:coverage`)
				"ryanluker.vscode-coverage-gutters",
				// GitHub
				"github.vscode-github-actions",
				"GitHub.vscode-pull-request-github",
				// Spelling (the cSpell word list lives in .vscode/settings.json)
				"streetsidesoftware.code-spell-checker",
				"anteprimorac.html-end-tag-labels"
			],
			"settings": {
				"python.defaultInterpreterPath": "/workspaces/the-dozens-django/.venv/bin/python",
				"python.terminal.activateEnvironment": true,
				"python.analysis.autoImportCompletions": true,
				"python.analysis.extraPaths": ["/workspaces/the-dozens-django"],

				"python.testing.pytestEnabled": true,
				"python.testing.unittestEnabled": false,

				"[python]": {
					"editor.defaultFormatter": "ms-python.black-formatter",
					"editor.formatOnSave": true,
					"editor.codeActionsOnSave": {
						"source.organizeImports": "explicit"
					}
				},
				"isort.args": ["--settings-path", "/workspaces/the-dozens-django/pyproject.toml"],
				"pylint.args": [
					"--rcfile=/workspaces/the-dozens-django/.configs/.pylintrc",
					"--load-plugins=pylint_django",
					"--django-settings-module=core.settings"
				],
				"mypy-type-checker.args": ["--config-file=/workspaces/the-dozens-django/pyproject.toml"],
				"ruff.nativeServer": "on",

				"files.associations": {
					"**/templates/**/*.html": "django-html",
					"**/templates/**/*.txt": "django-txt"
				},
				"[django-html]": {
					"editor.defaultFormatter": "monosans.djlint"
				},
				"emmet.includeLanguages": {
					"django-html": "html"
				},

				"coverage-gutters.coverageFileNames": ["cobertura.xml", "coverage.xml"],

				"doppler.autocomplete.enable": true,
				"doppler.hover.enable": true,

				"files.exclude": {
					"**/__pycache__": true,
					"**/.mypy_cache": true,
					"**/.ruff_cache": true,
					"**/.pytest_cache": true
				},
				"search.exclude": {
					"**/.venv": true,
					"**/htmlcov": true,
					"**/.kolo": true,
					"**/staticfiles": true
				}
			}
		}
	},

	"remoteUser": "vscode"
}
